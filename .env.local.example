# Google Places API (New) — Pro-tier fields only (5,000 free calls/month)
# Enable "Places API (New)" in Google Cloud, then create an API key.
GOOGLE_PLACES_API_KEY=

# Soft monthly cap (default 4500, hard max 5000 = Google Pro free tier)
PLACES_MONTHLY_CAP=4500

# Google Analytics 4 Measurement ID (omit locally to skip loading gtag)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
